plugins {
    id 'nf-core-utils@0.7.0-dev'
}

params {
    outdir          = 'results'
    run_multiqc     = true
    validate_params = false
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '1 GB'
    time     = '10 min'
    withName: SAMTOOLS_VIEW {
        ext.args = '--output-fmt bam'
    }
}

conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']
}
