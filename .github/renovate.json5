{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>nf-core/.github:renovate-config"],
  packageRules: [
    {
      // Nextflow is bumped by hand, with the supported versions in validation.yml
      matchDepNames: ["github:nextflow-io/nextflow"],
      enabled: false,
    },
  ],
}
